# Contact form + project builder enquiries are emailed through your mailbox's SMTP.
# Copy to .env.local for local testing, and add the same keys in your host's
# environment variables (Vercel / Netlify → Site settings → Environment variables).
# Get the host and port from your email provider (Zoho, Hostinger, GoDaddy, Google Workspace…).

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=info@akgroupz.in
SMTP_PASS=your-mailbox-or-app-password

# Optional: where enquiries land. Defaults to the email in src/data/site.ts.
# CONTACT_TO=info@akgroupz.in
